27. Remove Element

class Solution {
    public int removeElement(int[] nums, int val) {
        int i = 0;
        for (int j = 0; j < nums.length; j++) {
            if (nums[j] != val) {
                int k = nums[i];
                nums[i] = nums[j];
                nums[j] = k;
                i++;
            }
        }
        return i;
    }
}

