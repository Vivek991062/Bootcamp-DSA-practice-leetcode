1679. Max Number of K-Sum Pairs

class Solution {
    public int maxOperations(int[] nums, int k) {

        Arrays.sort(nums);

        int count = 0;
        int i = 0;
        int j = nums.length - 1;

        while (i < j) {
            int sum = nums[i] + nums[j];

            if (sum == k) {
                count++;
                i++;
                j--;
            } else if (sum > k) {
                j--;
            } else {
                i++;
            }
        }

        return count;
    }
}

